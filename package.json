{
  "name": "australian-poker-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && yarn build:ssr && yarn node scripts/prerender.mjs && node scripts/gen-seo-files.mjs",
    "build:ssr": "vite build --ssr src/entry-prerender.jsx --outDir .prerender --logLevel warn",
    "build:analyze": "ANALYZE=true vite build",
    "prerender": "yarn node scripts/prerender.mjs",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icons.mjs",
    "status": "node scripts/series-status.mjs",
    "admin": "node admin/server.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.0",
    "tinymce": "6.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependenciesMeta": {
    "tinymce": {
      "unplugged": true
    }
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22"
  }
}
